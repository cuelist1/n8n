      "parameters": {
        "jsCode": "const containers = $json;\n\nconst list = Array.isArray(containers)\n ? containers\n : (containers.containers || containers.data || []);\n\nconst gluetun = list.find(c => {\n const name = String(c.name || c.Names || '').replace(/^\\//, '');\n return name === 'gluetun';\n});\n\nif (!gluetun) {\n throw new Error('Could not find container named gluetun');\n}\n\nreturn [{\n json: {\n gluetunId: gluetun.id || gluetun.Id,\n gluetunName: String(gluetun.name || gluetun.Names || '').replace(/^\\//, '')\n }\n}];"
