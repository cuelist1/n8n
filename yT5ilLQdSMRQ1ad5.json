      "id": "8d3fcd74-8a19-4b52-8bd3-7421c68e20ae",
      "name": "File Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -656,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get the original data from Prepare Data node\nconst preparedData = $('Prepare Data').item.json;\nconst githubResponse = $input.first().json;\n\n// File exists - check if content is different\nconst existingContent = Buffer.from(githubResponse.content, 'base64').toString('utf8');\nconst newContent = preparedData.file_content;\n\nif (existingContent === newContent) {\n  return [{ json: { \n    workflow_id: preparedData.workflow_id,\n    workflow_name: preparedData.workflow_name,\n    github_owner: preparedData.github_owner,\n    github_repo: preparedData.github_repo,\n    file_path: preparedData.file_path,\n    file_content: preparedData.file_content,\n    action: 'skip', \n    message: 'No changes' \n  } }];\n} else {\n  return [{ json: { \n    workflow_id: preparedData.workflow_id,\n    workflow_name: preparedData.workflow_name,\n    github_owner: preparedData.github_owner,\n    github_repo: preparedData.github_repo,\n    file_path: preparedData.file_path,\n    file_content: preparedData.file_content,\n    action: 'update', \n    sha: githubResponse.sha \n  } }];\n}"
      },
