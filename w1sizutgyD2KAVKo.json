        -1456,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "const content = $input.first().json.patchContent;\n\n// Clean up the content but keep structure\nlet cleanContent = content\n  .replace(/From OpenEMR Project Wiki/gi, '')\n  .replace(/Retrieved from.*$/gm, '')\n  .replace(/Categories:.*$/gm, '')\n  .replace(/\\[edit\\]/g, '')\n  .trim();\n\n// Extract version - try multiple patterns\nlet version = 'Unknown Version';\n\n// Pattern 1: \"OpenEMR 7.0.3 Patches\" or \"7.0.3 Patches\"\nconst versionMatch1 = cleanContent.match(/OpenEMR\\s+([\\d.]+)\\s+Patches?/i);\nif (versionMatch1) {\n  version = versionMatch1[1];\n} else {\n  // Pattern 2: Just version number followed by Patches\n  const versionMatch2 = cleanContent.match(/([\\d.]+)\\s+Patches?/i);\n  if (versionMatch2) {\n    version = versionMatch2[1];\n  } else {\n    // Pattern 3: Look for version in title or heading\n    const versionMatch3 = cleanContent.match(/version\\s+([\\d.]+)/i);\n    if (versionMatch3) {\n      version = versionMatch3[1];\n    } else {\n      // Pattern 4: Just find any version-like number\n      const versionMatch4 = cleanContent.match(/([\\d]+\\.[\\d]+\\.[\\d]+)/i);\n      if (versionMatch4) {\n        version = versionMatch4[1];\n      }\n    }\n  }\n}\n\n// Try to extract patch listings\nconst patchSections = [];\nconst lines = cleanContent.split('\\n');\nfor (let i = 0; i < lines.length; i++) {\n  const line = lines[i].trim();\n  if (line.match(/^Patch\\s+\\d+/i) || line.match(/^\\d+\\./)) {\n    patchSections.push(line);\n  } else if (line.length > 20 && line.match(/sql|fix|update|bug|security/i)) {\n    patchSections.push(line);\n  }\n}\n\nconst patchList = patchSections.length > 0 \n  ? patchSections.slice(0, 20).join('\\n') \n  : cleanContent.substring(0, 2000);\n\n// Check if there are patches\nconst hasPatches = !cleanContent.includes('no 7.0.4 patches yet') && \n                   !cleanContent.includes('There are no') &&\n                   cleanContent.length > 100;\n\nreturn {\n  json: {\n    cleanContent,\n    patchList,\n    version,\n    hasPatches,\n    timestamp: new Date().toISOString(),\n    patchCount: patchSections.length\n  }\n};"
      },
