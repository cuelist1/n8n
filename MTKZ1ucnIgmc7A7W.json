      "id": "91156bed-5b61-4b45-afd8-23dec4aef664",
      "name": "Get All Workflows",
      "type": "n8n-nodes-base.n8n",
      "typeVersion": 1,
      "position": [
        1520,
        3136
      ],
      "credentials": {
        "n8nApi": {
          "id": "6GGuXl4bI8fmAaTZ",
          "name": "n8n account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Get config from previous node\nconst github_owner = $('Config').first().json.github_owner;\nconst github_repo = $('Config').first().json.github_repo;\n\n// For each workflow, create the GitHub file content\nconst items = [];\n\nfor (const item of $input.all()) {\n  const workflow = item.json;\n  \n  items.push({\n    json: {\n      workflow_id: workflow.id,\n      workflow_name: workflow.name,\n      github_owner: github_owner,\n      github_repo: github_repo,\n      file_path: `${workflow.id}.json`,\n      file_content: JSON.stringify(workflow, null, 2)\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "b45ce00f-74da-4de9-8191-27c26dd32e3b",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1744,
        3136
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "get",
        "owner": {
