    {
      "parameters": {
        "jsCode": "// Extract the session ID from the form action\nconst html = $input.item.json.body || '';\n\n// Look for the form action with the ID parameter\nconst formMatch = html.match(/action=\"\\/goform\\/RouterStatus\\?id=(\\d+)\"/i);\n\nlet sessionId = '';\nif (formMatch && formMatch[1]) {\n  sessionId = formMatch[1];\n}\n\n// Extract XSRF token from cookies if present\nconst cookies = $input.item.json.headers['set-cookie'] || [];\nlet xsrfToken = '';\n\nif (Array.isArray(cookies)) {\n  for (const cookie of cookies) {\n    const match = cookie.match(/XSRF_TOKEN=([^;]+)/);\n    if (match) {\n      xsrfToken = match[1];\n      break;\n    }\n  }\n} else if (typeof cookies === 'string') {\n  const match = cookies.match(/XSRF_TOKEN=([^;]+)/);\n  if (match) {\n    xsrfToken = match[1];\n  }\n}\n\nreturn {\n  sessionId: sessionId,\n  xsrfToken: xsrfToken,\n  rebootUrl: `http://192.168.100.1/goform/RouterStatus?id=${sessionId}`\n};"
      },
