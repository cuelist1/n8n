        -800,
        64
      ],
      "id": "c9a62051-8088-45fe-8e88-30cfa7145553"
    },
    {
      "parameters": {
        "functionCode": "const cheerio = require('cheerio');\nconst $ = cheerio.load(items[0].json.data);\n\nconst patches = [];\n$('#mw-content-text ul li').each((i, el) => {\n  const text = $(el).text().trim();\n  const match = text.match(/Patch\\s+(\\d+(?:\\.\\d+)+).*?(\\w+\\s+\\d{4})/i);\n  if (match) {\n    patches.push({ version: match[1], date: match[2] });\n  }\n});\n\nreturn [{ json: { patches } }];"
      },
      "name": "Extract Patches",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -608,
        64
      ],
      "id": "5a927530-5f57-4c76-ac99-cf7d047e9df0"
    },
    {
      "parameters": {},
      "name": "Load Stored Patches",
      "type": "n8n-nodes-base.dataStore",
      "typeVersion": 1,
      "position": [
        -608,
        208
      ],
      "id": "2812c49a-3a3a-4d35-93c6-28fdc237ec28"
    },
    {
      "parameters": {
        "functionCode": "const current = $json[\"patches\"];\nconst previous = $json[\"value\"] ? JSON.parse($json[\"value\"]) : [];\n\nconst prevVersions = previous.map(p => p.version);\nconst newPatches = current.filter(p => !prevVersions.includes(p.version));\n\nreturn [{ json: { newPatches, storedPatches: current } }];"
      },
      "name": "Compare Patches",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -400,
        64
      ],
      "id": "1d80763f-ce9d-4927-b315-560c19ca1775"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json[\"newPatches\"].length}}",
              "operation": "notEqual",
              "value2": "0"
            }
          ]
        }
      },
      "name": "Check New Patches",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -208,
        64
      ],
      "id": "d25c2384-3462-42f9-a596-31273c94f07a"
    },
    {
      "parameters": {
        "functionCode": "const newPatches = $json[\"newPatches\"];\n\nlet summary = \"New OpenEMR patches detected:\\n\\n\";\nnewPatches.forEach(p => {\n  summary += `- Version ${p.version} (released ${p.date})\\n`;\n});\nsummary += \"\\nSee details: https://www.open-emr.org/wiki/index.php/OpenEMR_Patches\";\n\nreturn [{ json: { summary } }];"
      },
