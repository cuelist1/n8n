        -944,
        -64
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get all the input data\nconst inputData = $input.first().json;\nconst currentHash = inputData.hash;\n\nif (!currentHash) {\n  throw new Error('Hash is missing from input data. Available keys: ' + Object.keys(inputData).join(', '));\n}\n\n// Try to get previous hash from static data\nlet previousHash = 'initial';\ntry {\n  const staticData = $workflow.staticData;\n  if (staticData && staticData.lastHash) {\n    previousHash = staticData.lastHash;\n  }\n} catch (e) {\n  previousHash = 'initial';\n}\n\n// Check if content has changed\nconst hasChanged = currentHash !== previousHash;\n\nconsole.log('Hash Check:', {\n  currentHash,\n  previousHash,\n  hasChanged\n});\n\n// Return all data needed for email\nreturn {\n  json: {\n    currentHash: currentHash,\n    previousHash: previousHash,\n    hasChanged: hasChanged,\n    cleanContent: inputData.cleanContent || 'No content',\n    patchList: inputData.patchList || 'No patches listed',\n    version: inputData.version || 'Unknown',\n    patchCount: inputData.patchCount || 0,\n    timestamp: inputData.timestamp || new Date().toISOString()\n  }\n};"
      },
