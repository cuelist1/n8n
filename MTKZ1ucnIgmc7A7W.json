        },
        "filePath": "={{ $json.file_path }}",
        "asBinaryProperty": false,
        "additionalParameters": {}
      },
      "id": "d71a544f-c991-4dc1-957c-044084d67644",
      "name": "Get Existing File",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        1952,
        3136
      ],
      "alwaysOutputData": true,
      "webhookId": "ae5e0d1d-7a62-4f6e-8bb6-2f7eb620e320",
      "credentials": {
        "githubApi": {
          "id": "BtzYzYVmaJFk1wWn",
          "name": "GitHub account"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
